<Window x:Class="VaultGuardian.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="420" Width="480"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <!-- General -->
            <TextBlock Text="GENERAL" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
            <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox x:Name="LaunchAtStartupBox"
                              Content="Launch VaultGuardian at Windows startup"
                              Foreground="{StaticResource PrimaryTextBrush}"
                              Margin="0,0,0,10"/>
                    <CheckBox x:Name="MinimizeToTrayBox"
                              Content="Minimize to system tray on window close"
                              Foreground="{StaticResource PrimaryTextBrush}"/>
                </StackPanel>
            </Border>

            <!-- Monitoring -->
            <TextBlock Text="MONITORING" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
            <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox x:Name="ShowOverlayOnStartBox"
                              Content="Show desktop overlay when app starts"
                              Foreground="{StaticResource PrimaryTextBrush}"
                              Margin="0,0,0,14"/>

                    <TextBlock Text="Dashboard refresh interval" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="RefreshSlider"
                                Grid.Column="0"
                                Minimum="250" Maximum="5000"
                                TickFrequency="250"
                                IsSnapToTickEnabled="True"
                                ValueChanged="OnRefreshSliderChanged"
                                VerticalAlignment="Center"/>
                        <TextBlock x:Name="RefreshLabel"
                                   Grid.Column="1"
                                   Width="70"
                                   TextAlignment="Right"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Click="OnCancelClick" Padding="15,8" Margin="0,0,10,0"/>
            <Button Content="Save" Click="OnSaveClick" Padding="15,8" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
