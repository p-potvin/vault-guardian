<Window
    x:Class="VaultGuardian.UI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1A1230" Offset="0"/>
                <GradientStop Color="#0b0813" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Settings" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,20"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <!-- General -->
                    <TextBlock Text="GENERAL" Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11" FontWeight="Bold"/>
                    <Border Background="{StaticResource ConsoleRaisedBrush}"
                            BorderBrush="{StaticResource ConsoleBorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="16">
                        <StackPanel Spacing="12">
                            <ToggleSwitch x:Name="LaunchAtStartupSwitch"
                                         Header="Launch VaultGuardian at Windows startup"
                                         Foreground="{StaticResource PrimaryTextBrush}"/>
                            <ToggleSwitch x:Name="MinimizeToTraySwitch"
                                         Header="Minimize to system tray on window close"
                                         Foreground="{StaticResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Monitoring -->
                    <TextBlock Text="MONITORING" Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11" FontWeight="Bold"/>
                    <Border Background="{StaticResource ConsoleRaisedBrush}"
                            BorderBrush="{StaticResource ConsoleBorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="16">
                        <StackPanel Spacing="12">
                            <ToggleSwitch x:Name="ShowOverlayOnStartSwitch"
                                         Header="Show desktop overlay when app starts"
                                         Foreground="{StaticResource PrimaryTextBrush}"/>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Dashboard refresh interval"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="RefreshSlider"
                                            Grid.Column="0"
                                            Minimum="250" Maximum="5000"
                                            StepFrequency="250"
                                            SnapsTo="StepValues"
                                            ValueChanged="OnRefreshSliderChanged"
                                            VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RefreshLabel"
                                               Grid.Column="1"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"
                                               FontFamily="{StaticResource VaultMonoFontFamily}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,16,0,0" Spacing="10">
                <Button Content="Cancel" Click="OnCancelClick"
                        Padding="18,10"
                        Background="{StaticResource ConsoleRaisedBrush}"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        BorderBrush="{StaticResource ConsoleBorderBrush}"
                        CornerRadius="12"/>
                <Button Content="Save" Click="OnSaveClick"
                        Padding="18,10"
                        Background="{StaticResource ConsoleGoldBrush}"
                        Foreground="#1A1230" FontWeight="SemiBold"
                        BorderThickness="0" CornerRadius="12"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
