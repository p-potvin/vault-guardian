<Application x:Class="VaultGuardian.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VaultGuardian.UI"
             xmlns:h="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf">
    <Application.Resources>
        <ResourceDictionary>
            <h:TaskbarIcon x:Key="NotifyIcon"
                           IconSource="pack://application:,,,/Assets/Icon.ico"
                           ToolTipText="VaultGuardian Passive Monitor">
                <h:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Show Dashboard" Click="ShowMainWindow_Click"/>
                        <Separator/>
                        <MenuItem Header="Exit" Click="ExitApp_Click"/>
                    </ContextMenu>
                </h:TaskbarIcon.ContextMenu>
            </h:TaskbarIcon>

            <!-- Modern Fluent-like Colors -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="#1C1C1C"/>
            <SolidColorBrush x:Key="CardBrush" Color="#282828"/>
            <SolidColorBrush x:Key="CardHoverBrush" Color="#323232"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#323232"/>
            <SolidColorBrush x:Key="ControlStrokeBrush" Color="#404040"/>
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A0A0A0"/>
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#707070"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="#E81123"/>

            <Style TargetType="ProgressBar">
                <Setter Property="Background" Value="#1AFFFFFF"/>
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Height" Value="4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid x:Name="TemplateRoot">
                                <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                                <Grid x:Name="Indicator" HorizontalAlignment="Left" Margin="0">
                                    <Border Background="{TemplateBinding Foreground}" CornerRadius="2"/>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
