<Window
    x:Class="VaultGuardian.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VaultGuardian.UI"
    Title="VaultGuardian">
    <!-- Warm document frame: the parchment "desk" that wraps the console operational core -->
    <Grid x:Name="RootShell" Background="{StaticResource WarmShellBackgroundBrush}">

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Warm branded header (structural frame): logo wordmark + bilingual tagline -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="ms-appx:///Assets/vaultwares-logo.png"
                       Width="46" Height="46" VerticalAlignment="Center"
                       Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="VaultGuardian"
                               FontSize="30" FontWeight="SemiBold"
                               FontFamily="{StaticResource VaultFontFamily}"
                               Foreground="{StaticResource WarmPrimaryTextBrush}"/>
                    <TextBlock x:Name="BrandTaglineText"
                               Text="Privacy first. Security in service."
                               Foreground="{StaticResource WarmSecondaryTextBrush}"
                               FontSize="14" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Console operational core nested inside the warm frame -->
            <Border Grid.Row="1"
                    Background="{StaticResource ConsoleShellBackgroundBrush}"
                    BorderBrush="{StaticResource ConsoleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Padding="16,8,16,16">
            <Pivot x:Name="MainPivot" SelectionChanged="OnPivotChanged" Background="Transparent">
                <PivotItem Header="Dashboard">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <Border Background="{StaticResource ConsoleRaisedBrush}"
                                    BorderBrush="{StaticResource ConsoleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CardCornerRadius}"
                                    Padding="24" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Network Traffic Flow" FontSize="20" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,20"/>
                                    <local:MetricControl x:Name="TrafficSentMetric" Label="Outbound bandwidth" Margin="0,0,0,15"/>
                                    <local:MetricControl x:Name="TrafficRecvMetric" Label="Inbound bandwidth"  Margin="0,0,0,15"/>

                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <local:StatBox x:Name="TotalStats"   Grid.Column="0" Label="TOTAL FLOWS" Margin="0,0,10,0"/>
                                        <local:StatBox x:Name="BlockedStats" Grid.Column="1" Label="BLOCKED"/>
                                    </Grid>

                                    <Button Content="View Network Details" Click="OnToggleDetailsClick"
                                            Margin="0,15,0,0" Padding="14,8"
                                            Background="Transparent"
                                            BorderBrush="{StaticResource ConsoleBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Foreground="{StaticResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource ConsoleRaisedBrush}"
                                    BorderBrush="{StaticResource ConsoleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CardCornerRadius}"
                                    Padding="24">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Live Actions" FontSize="18" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Control how monitoring is displayed"
                                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="ShowOverlayCheckbox" Content="Desktop Overlay"
                                                  IsChecked="True"
                                                  Checked="OnOverlayToggled" Unchecked="OnOverlayToggled"
                                                  Margin="0,0,20,0"
                                                  Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <Button Content="Manage Rules" Click="OnManageRulesClick"
                                                Padding="22,10"
                                                Background="{StaticResource IrisBrush}"
                                                Foreground="#0A0C11"
                                                FontWeight="SemiBold"
                                                BorderThickness="0"
                                                CornerRadius="12"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="{StaticResource ConsoleRaisedBrush}"
                                BorderBrush="{StaticResource ConsoleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="24" Margin="0,0,0,16" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Disk Operations" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,20"/>
                                <local:MetricControl x:Name="DiskReadMetric"  Label="Active Read Speed"  Margin="0,0,0,15"/>
                                <local:MetricControl x:Name="DiskWriteMetric" Label="Active Write Speed" Margin="0,0,0,15"/>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="QUEUE" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/>
                                        <TextBlock x:Name="DiskQueueText" Text="0"
                                                   FontFamily="{StaticResource VaultMonoFontFamily}"
                                                   Foreground="{StaticResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="ACTIVE TIME" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/>
                                        <TextBlock x:Name="DiskActiveText" Text="0%"
                                                   FontFamily="{StaticResource VaultMonoFontFamily}"
                                                   Foreground="{StaticResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>

                                <Button Content="View Disk Details" Click="OnToggleDetailsClick"
                                        Margin="0,15,0,0" Padding="14,8"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource ConsoleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Foreground="{StaticResource SecondaryTextBrush}"/>
                            </StackPanel>
                        </Border>

                        <Grid x:Name="DetailsPopup" Grid.ColumnSpan="2" Background="#E60b0813"
                              Visibility="Collapsed" Canvas.ZIndex="10" Margin="-10">
                            <Border Background="{StaticResource ConsoleElevatedBrush}"
                                    BorderBrush="{StaticResource IrisBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CardCornerRadius}"
                                    Margin="40" Padding="30">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="System Deep Investigation" FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,20"/>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="Disk &amp; Partition Layout" Foreground="{StaticResource IrisBrush}"
                                                       FontWeight="Bold" Margin="0,0,0,10"/>
                                            <TextBlock x:Name="DiskDetailedDetails" Text="Querying counters..."
                                                       FontFamily="{StaticResource VaultMonoFontFamily}"
                                                       Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,20" TextWrapping="Wrap"/>

                                            <TextBlock Text="Active Network Adapters" Foreground="{StaticResource SignalOnlineBrush}"
                                                       FontWeight="Bold" Margin="0,0,0,10"/>
                                            <TextBlock x:Name="NetworkDetailedDetails" Text="Resolving interface statistics..."
                                                       FontFamily="{StaticResource VaultMonoFontFamily}"
                                                       Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,20" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <Button Grid.Row="2" Content="Close Details" Click="OnToggleDetailsClick"
                                            HorizontalAlignment="Right" Padding="18,10"
                                            Background="{StaticResource IrisBrush}"
                                            Foreground="#0A0C11" FontWeight="SemiBold"
                                            BorderThickness="0" CornerRadius="12"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                    </ScrollViewer>
                </PivotItem>

                <PivotItem Header="Performance">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <Border Background="{StaticResource ConsoleRaisedBrush}"
                                    BorderBrush="{StaticResource ConsoleBorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource CardCornerRadius}" Padding="24" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="CORE UTILIZATION" Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="12" FontWeight="Bold" Margin="0,0,0,15"/>
                                    <local:MetricControl x:Name="CpuDetailed"        Label="CPU Utilization" Margin="0,0,0,15"/>
                                    <local:MetricControl x:Name="RamDetailed"        Label="Memory Usage"    Margin="0,0,0,15"/>
                                    <TextBlock x:Name="RamDetailsText" Text="Available: 0 GB | Total: 0 GB"
                                               FontFamily="{StaticResource VaultMonoFontFamily}"
                                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,15"/>

                                    <local:MetricControl x:Name="GpuDetailed"        Label="GPU Load"  Margin="0,0,0,15"/>
                                    <local:MetricControl x:Name="CudaDetailedMetric" Label="CUDA Cores" Margin="0,0,0,15"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource ConsoleRaisedBrush}"
                                    BorderBrush="{StaticResource ConsoleBorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource CardCornerRadius}" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="STORAGE SUB-SYSTEM" Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="12" FontWeight="Bold" Margin="0,0,0,15"/>
                                    <local:MetricControl x:Name="DiskDetailedRead"  Label="Disk Read Throughput"  Margin="0,0,0,15"/>
                                    <local:MetricControl x:Name="DiskDetailedWrite" Label="Disk Write Throughput" Margin="0,0,0,15"/>
                                    <local:MetricControl x:Name="DiskDetailedTime"  Label="Active Time"          Margin="0,0,0,15"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <!-- One GpuPanel per detected device, populated in code-behind. -->
                            <StackPanel x:Name="GpuDetailedStack"/>

                            <Border Background="{StaticResource ConsoleRaisedBrush}"
                                    BorderBrush="{StaticResource ConsoleBorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource CardCornerRadius}" Padding="24" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="CUDA ENGINE" Foreground="{StaticResource SecondaryTextBrush}"
                                               FontFamily="{StaticResource VaultMonoFontFamily}"
                                               FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="CudaDetailedText" Text="0% Utilized"
                                               FontFamily="{StaticResource VaultMonoFontFamily}"
                                               Foreground="{StaticResource PrimaryTextBrush}" FontSize="16"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource ConsoleRaisedBrush}"
                                    BorderBrush="{StaticResource ConsoleBorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource CardCornerRadius}" Padding="24" Margin="0,15,0,0">
                                <StackPanel>
                                    <TextBlock Text="NETWORKING" Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="12" FontWeight="Bold" Margin="0,0,0,15"/>
                                    <TextBlock x:Name="TrafficDetailsText" Text="Monitoring active..."
                                               FontFamily="{StaticResource VaultMonoFontFamily}"
                                               Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    </ScrollViewer>
                </PivotItem>

                <PivotItem Header="Ingress">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="IngressStatusText" Grid.Row="0" Grid.ColumnSpan="3"
                                       Text="Capture: disabled in settings"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontFamily="{StaticResource VaultMonoFontFamily}"
                                       FontSize="12" Margin="0,0,0,10"/>

                            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource ConsoleSurfaceBrush}"
                                    BorderBrush="{StaticResource ConsoleBorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource PanelCornerRadius}" Padding="18" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="INGRESS PACKETS" Foreground="{StaticResource TertiaryTextBrush}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="IngressPacketCountText" Text="0"
                                               FontFamily="{StaticResource VaultMonoFontFamily}"
                                               Foreground="{StaticResource PrimaryTextBrush}" FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource ConsoleSurfaceBrush}"
                                    BorderBrush="{StaticResource ConsoleBorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource PanelCornerRadius}" Padding="18" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="REMOTE SOURCES" Foreground="{StaticResource TertiaryTextBrush}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="IngressSourceCountText" Text="0"
                                               FontFamily="{StaticResource VaultMonoFontFamily}"
                                               Foreground="{StaticResource PrimaryTextBrush}" FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource ConsoleSurfaceBrush}"
                                    BorderBrush="{StaticResource ConsoleBorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource PanelCornerRadius}" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="ARCHIVED BYTES" Foreground="{StaticResource TertiaryTextBrush}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="IngressByteCountText" Text="0 MB"
                                               FontFamily="{StaticResource VaultMonoFontFamily}"
                                               Foreground="{StaticResource PrimaryTextBrush}" FontSize="24" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.4*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{StaticResource ConsoleRaisedBrush}"
                                    BorderBrush="{StaticResource ConsoleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CardCornerRadius}"
                                    Padding="20" Margin="0,0,12,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Inbound Sources" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                                    <ListView x:Name="IngressSourceList" Grid.Row="1" MinHeight="200" MaxHeight="420"
                                              SelectionChanged="OnIngressSourceSelectionChanged"
                                              Background="{StaticResource ConsoleSurfaceBrush}"
                                              Foreground="{StaticResource PrimaryTextBrush}"
                                              BorderBrush="{StaticResource ConsoleBorderBrush}"
                                              BorderThickness="1"/>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                        <Button Content="Export Flow" Click="OnExportIngressFlowClick"
                                                Padding="14,8" Margin="0,0,10,0"
                                                Background="Transparent"
                                                BorderBrush="{StaticResource ConsoleBorderBrush}"
                                                BorderThickness="1"
                                                Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <Button Content="Clear Archive" Click="OnClearIngressArchiveClick"
                                                Padding="14,8"
                                                Background="{StaticResource IrisBrush}"
                                                Foreground="#0A0C11"
                                                FontWeight="SemiBold"
                                                BorderThickness="0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="{StaticResource ConsoleRaisedBrush}"
                                    BorderBrush="{StaticResource ConsoleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CardCornerRadius}"
                                    Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Selected Flow" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                                    <TextBlock x:Name="IngressDetailsText" Grid.Row="1"
                                               Text="No inbound packets archived yet."
                                               FontFamily="{StaticResource VaultMonoFontFamily}"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                                  Background="{StaticResource ConsoleSurfaceBrush}">
                                        <TextBlock x:Name="IngressPayloadPreviewText"
                                                   Text="Payload preview will appear after inbound traffic is captured."
                                                   FontFamily="{StaticResource VaultMonoFontFamily}"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="12" TextWrapping="Wrap" Padding="14"/>
                                    </ScrollViewer>
                                    <TextBlock x:Name="MitmProxyStatusText"
                                               Grid.Row="3"
                                               Text="Browser MITM: stopped"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontFamily="{StaticResource VaultMonoFontFamily}"
                                               FontSize="12"
                                               Margin="0,10,0,0"/>
                                    <TextBlock x:Name="FullTraceStatusText"
                                               Grid.Row="3"
                                               Text="Full trace: idle"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontFamily="{StaticResource VaultMonoFontFamily}"
                                               FontSize="12"
                                               HorizontalAlignment="Right"
                                               Margin="0,10,0,0"/>
                                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button x:Name="StartBrowserMitmButton"
                                                Content="Start Browser MITM"
                                                Click="OnStartBrowserMitmClick"
                                                Padding="14,8"
                                                Margin="0,0,10,0"
                                                Background="Transparent"
                                                BorderBrush="{StaticResource ConsoleBorderBrush}"
                                                BorderThickness="1"
                                                Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <Button x:Name="StopBrowserMitmButton"
                                                Content="Stop Browser MITM"
                                                Click="OnStopBrowserMitmClick"
                                                Padding="14,8"
                                                Background="Transparent"
                                                BorderBrush="{StaticResource ConsoleBorderBrush}"
                                                BorderThickness="1"
                                                Foreground="{StaticResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        <ListView x:Name="IngressTelemetryHitsList"
                                  Grid.Row="1"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Width="420"
                                  MaxHeight="150"
                                  Background="{StaticResource ConsoleSurfaceBrush}"
                                  Foreground="{StaticResource PrimaryTextBrush}"
                                  BorderBrush="{StaticResource ConsoleBorderBrush}"
                                  BorderThickness="1"
                                  Margin="0,0,20,20"/>
                    </Grid>
                    </ScrollViewer>
                </PivotItem>

                <PivotItem Header="Processes">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Process Triage" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"/>
                                <TextBlock x:Name="ProcessStatusText"
                                           Text="Expensive and hidden processes, tagged by shutdown risk."
                                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Refresh" Click="OnRefreshProcessesClick"
                                    Padding="18,8"
                                    Background="{StaticResource IrisBrush}"
                                    Foreground="#0A0C11" FontWeight="SemiBold"
                                    BorderThickness="0" CornerRadius="10" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="{StaticResource ConsoleRaisedBrush}"
                                BorderBrush="{StaticResource ConsoleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="8">
                            <ListView x:Name="ProcessList" MinHeight="240" MaxHeight="460"
                                      SelectionChanged="OnProcessSelectionChanged"
                                      Background="Transparent"
                                      Foreground="{StaticResource PrimaryTextBrush}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:ProcessRowVM">
                                        <Grid Padding="6,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.2*"/>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="0.9*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1.6*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Display}"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       FontFamily="{StaticResource VaultMonoFontFamily}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Cpu}"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontFamily="{StaticResource VaultMonoFontFamily}" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind Memory}"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontFamily="{StaticResource VaultMonoFontFamily}" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{x:Bind Disposition}"
                                                       Foreground="{x:Bind DispositionBrush}"
                                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{x:Bind KillSafety}"
                                                       Foreground="{x:Bind KillSafetyBrush}"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>

                        <Border Grid.Row="2"
                                Background="{StaticResource ConsoleSurfaceBrush}"
                                BorderBrush="{StaticResource ConsoleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource PanelCornerRadius}"
                                Padding="16" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ProcessReasonsText" Grid.Column="0"
                                           Text="Select a process to see why it was tagged."
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Button x:Name="TerminateProcessButton" Grid.Column="1"
                                        Content="Terminate" Click="OnTerminateProcessClick"
                                        IsEnabled="False"
                                        Padding="16,8" Margin="12,0,0,0"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource SignalAlertBrush}"
                                        BorderThickness="1"
                                        Foreground="{StaticResource SignalAlertBrush}"
                                        CornerRadius="10" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                    </ScrollViewer>
                </PivotItem>
            </Pivot>
            </Border>

            <Border Grid.Row="2"
                    Background="#26D6A441"
                    BorderBrush="{StaticResource IrisBrush}"
                    BorderThickness="1"
                    CornerRadius="12" Padding="16" Margin="0,24,0,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10"
                             Fill="{StaticResource SignalOnlineBrush}"
                             VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="System Protected: WinDivert is actively enforcing security rules."
                               Foreground="{StaticResource WarmPrimaryTextBrush}"
                               VerticalAlignment="Center" FontWeight="Medium"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
