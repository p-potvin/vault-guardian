<Window
    x:Class="VaultGuardian.UI.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="OverlayRoot"
            Background="{StaticResource ConsoleRaisedBrush}"
            BorderBrush="{StaticResource ConsoleBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            Padding="12"
            PointerPressed="OverlayRoot_PointerPressed">
        <StackPanel>
            <Grid Margin="0,0,0,8">
                <TextBlock Text="MONITOR" FontWeight="Bold" FontSize="9"
                           Foreground="{StaticResource TertiaryTextBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Ellipse x:Name="StatusLed" Width="8" Height="8"
                             Fill="{StaticResource SignalOnlineBrush}"
                             VerticalAlignment="Center" Margin="0,0,4,0">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="LedScale" CenterX="4" CenterY="4" ScaleX="1" ScaleY="1"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock x:Name="BlockedText" Text="0"
                               FontFamily="{StaticResource VaultMonoFontFamily}"
                               Foreground="{StaticResource SignalAlertBrush}" FontSize="10" FontWeight="Bold"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,4">
                <TextBlock Text="CPU" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                <TextBlock x:Name="CpuText" Text="0%" FontSize="11" HorizontalAlignment="Right" FontWeight="SemiBold"
                           FontFamily="{StaticResource VaultMonoFontFamily}"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
            </Grid>
            <ProgressBar x:Name="CpuBar" Height="2" Margin="0,0,0,8"
                         Foreground="{StaticResource SignalRelayBrush}"/>

            <Grid Margin="0,0,0,4">
                <TextBlock Text="RAM" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                <TextBlock x:Name="RamText" Text="0.0 GB" FontSize="11" HorizontalAlignment="Right" FontWeight="SemiBold"
                           FontFamily="{StaticResource VaultMonoFontFamily}"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
            </Grid>
            <ProgressBar x:Name="RamBar" Height="2" Margin="0,0,0,8"
                         Foreground="{StaticResource SignalOnlineBrush}"/>

            <Grid Margin="0,0,0,4">
                <TextBlock Text="GPU" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                <TextBlock x:Name="GpuText" Text="0%" FontSize="11" HorizontalAlignment="Right" FontWeight="SemiBold"
                           FontFamily="{StaticResource VaultMonoFontFamily}"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
            </Grid>
            <ProgressBar x:Name="GpuBar" Height="2" Margin="0,0,0,8"
                         Foreground="{StaticResource ConsoleGoldBrush}"/>

            <Grid Margin="0,0,0,4">
                <TextBlock Text="CUDA" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                <TextBlock x:Name="CudaText" Text="0%" FontSize="11" HorizontalAlignment="Right" FontWeight="SemiBold"
                           FontFamily="{StaticResource VaultMonoFontFamily}"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
            </Grid>
            <ProgressBar x:Name="CudaBar" Height="2"
                         Foreground="{StaticResource ConsoleVioletBrush}"/>
        </StackPanel>
    </Border>
</Window>
