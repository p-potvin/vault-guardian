<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Console Mode surface colors -->
    <Color x:Key="ConsoleBgColor">#0b0813</Color>
    <Color x:Key="ConsoleSurfaceColor">#13101c</Color>
    <Color x:Key="ConsoleRaisedColor">#2A2340</Color>
    <Color x:Key="ConsoleElevatedColor">#453763</Color>
    <Color x:Key="ConsoleActiveColor">#614d8a</Color>

    <SolidColorBrush x:Key="ConsoleBgBrush" Color="#0b0813"/>
    <SolidColorBrush x:Key="ConsoleSurfaceBrush" Color="#13101c"/>
    <SolidColorBrush x:Key="ConsoleRaisedBrush" Color="#2A2340"/>
    <SolidColorBrush x:Key="ConsoleElevatedBrush" Color="#453763"/>
    <SolidColorBrush x:Key="ConsoleActiveBrush" Color="#614d8a"/>
    <SolidColorBrush x:Key="ConsoleBorderBrush" Color="#0FFFFFFF"/>

    <!-- Accent brand -->
    <SolidColorBrush x:Key="ConsoleGoldBrush" Color="#D6A441"/>
    <SolidColorBrush x:Key="ConsoleVioletBrush" Color="#B07CFF"/>

    <!--
        Warm Mode / Document State surfaces. Per the "Terminal and Document"
        philosophy, Warm and Console coexist: the warm parchment frame (header,
        navigation, read-only surfaces) wraps the dark console operational core.
        Values are sourced from vaultwares-themes operational.warm tokens.
    -->
    <SolidColorBrush x:Key="WarmBgBrush" Color="#F5F1E8"/>
    <SolidColorBrush x:Key="WarmRaisedBrush" Color="#FCFAF5"/>
    <SolidColorBrush x:Key="WarmMutedBrush" Color="#ECE5D8"/>
    <SolidColorBrush x:Key="WarmBorderBrush" Color="#14161320"/>
    <SolidColorBrush x:Key="WarmPrimaryTextBrush" Color="#161320"/>
    <SolidColorBrush x:Key="WarmSecondaryTextBrush" Color="#746C82"/>
    <SolidColorBrush x:Key="WarmGoldBrush" Color="#CC9B21"/>

    <!-- Shell backgrounds: warm frame (parchment + golden bleed) and console core (violet + aubergine) -->
    <LinearGradientBrush x:Key="WarmShellBackgroundBrush" StartPoint="0.16,0" EndPoint="0.6,1">
        <GradientStop Color="#FBF3E2" Offset="0"/>
        <GradientStop Color="#F5F1E8" Offset="0.45"/>
        <GradientStop Color="#EFEADD" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ConsoleShellBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A1230" Offset="0"/>
        <GradientStop Color="#13101c" Offset="0.55"/>
        <GradientStop Color="#0b0813" Offset="1"/>
    </LinearGradientBrush>

    <!-- Text hierarchy -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#EDE6FF"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#a394cc"/>
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#7a6db0"/>

    <!-- Signal palette -->
    <SolidColorBrush x:Key="SignalOnlineBrush" Color="#6BE675"/>
    <SolidColorBrush x:Key="SignalRelayBrush" Color="#55D6FF"/>
    <SolidColorBrush x:Key="SignalSyncBrush" Color="#B07CFF"/>
    <SolidColorBrush x:Key="SignalWarningBrush" Color="#F0B94B"/>
    <SolidColorBrush x:Key="SignalAlertBrush" Color="#FF6B7A"/>

    <!-- WinUI default-brush overrides so unstyled controls fit Console Mode -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#0b0813"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#2A2340"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#453763"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#13101c"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#EDE6FF"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#a394cc"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#7a6db0"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#D6A441"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#B07CFF"/>

    <!-- Layout tokens -->
    <CornerRadius x:Key="CardCornerRadius">28</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">20</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>

    <!-- Typography tokens -->
    <FontFamily x:Key="VaultFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="VaultMonoFontFamily">JetBrains Mono, Consolas, Cascadia Mono</FontFamily>

    <!-- ProgressBar redesign -->
    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource ConsoleGoldBrush}"/>
        <Setter Property="MinHeight" Value="4"/>
        <Setter Property="CornerRadius" Value="2"/>
    </Style>
</ResourceDictionary>
