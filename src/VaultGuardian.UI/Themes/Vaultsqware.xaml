<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        vaultsqware (vaultwares²) — sourced from vaultwares-themes/vaultsqware/TOKENS.md.

        Console (obsidian) and warm (bone) are simultaneous regions, not light/dark
        modes: the console is the operational surface (~85%), warm is the framing
        rail and headers (~15%). There is no theme toggle.

        Alpha values from the CSS tokens are converted to #AARRGGBB here, e.g.
        rgba(186,194,210,.72) -> #B8BAC2D2.
    -->

    <!-- ── Console: obsidian ─────────────────────────────────────────────── -->
    <Color x:Key="ConsoleBgColor">#0A0C11</Color>
    <Color x:Key="ConsoleSurfaceColor">#11141B</Color>
    <Color x:Key="ConsoleRaisedColor">#191D27</Color>
    <Color x:Key="ConsoleElevatedColor">#242935</Color>
    <Color x:Key="ConsoleActiveColor">#323847</Color>

    <SolidColorBrush x:Key="ConsoleBgBrush" Color="#0A0C11"/>
    <SolidColorBrush x:Key="ConsoleSurfaceBrush" Color="#11141B"/>
    <SolidColorBrush x:Key="ConsoleSunkenBrush" Color="#070810"/>
    <SolidColorBrush x:Key="ConsoleRaisedBrush" Color="#191D27"/>
    <SolidColorBrush x:Key="ConsoleElevatedBrush" Color="#242935"/>
    <SolidColorBrush x:Key="ConsoleActiveBrush" Color="#323847"/>
    <SolidColorBrush x:Key="ConsoleHoverBrush" Color="#1F2430"/>
    <SolidColorBrush x:Key="ConsoleBorderBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="ConsoleBorderStrongBrush" Color="#1FFFFFFF"/>

    <!-- ── Warm: bone ────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="WarmBgBrush" Color="#EDECE8"/>
    <SolidColorBrush x:Key="WarmRaisedBrush" Color="#F8F7F4"/>
    <SolidColorBrush x:Key="WarmMutedBrush" Color="#DEDCD6"/>
    <SolidColorBrush x:Key="WarmSunkenBrush" Color="#E4E2DD"/>
    <SolidColorBrush x:Key="WarmPrimaryTextBrush" Color="#0F1116"/>
    <SolidColorBrush x:Key="WarmSecondaryTextBrush" Color="#A80F1116"/>
    <SolidColorBrush x:Key="WarmDimTextBrush" Color="#6B0F1116"/>
    <SolidColorBrush x:Key="WarmBorderBrush" Color="#1A0F1116"/>
    <SolidColorBrush x:Key="WarmBorderStrongBrush" Color="#2E0F1116"/>

    <!-- ── Accents: iris (primary) / coral (secondary) ───────────────────── -->
    <SolidColorBrush x:Key="IrisBrush" Color="#6E7BF2"/>
    <SolidColorBrush x:Key="IrisHoverBrush" Color="#8189F5"/>
    <SolidColorBrush x:Key="IrisPressedBrush" Color="#5866DC"/>
    <SolidColorBrush x:Key="IrisSoftBrush" Color="#246E7BF2"/>
    <SolidColorBrush x:Key="IrisDeepBrush" Color="#252D66"/>

    <SolidColorBrush x:Key="CoralBrush" Color="#FF8A6B"/>
    <SolidColorBrush x:Key="CoralHoverBrush" Color="#FF9679"/>
    <SolidColorBrush x:Key="CoralPressedBrush" Color="#E86F4F"/>
    <SolidColorBrush x:Key="CoralSoftBrush" Color="#24FF8A6B"/>

    <!-- ── Text ──────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#BAC2D2"/>
    <SolidColorBrush x:Key="BrightTextBrush" Color="#E6EAF2"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B8BAC2D2"/>
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#75BAC2D2"/>

    <!-- ── Signals: hardware-LED semantics ───────────────────────────────── -->
    <SolidColorBrush x:Key="SignalOnlineBrush" Color="#56D98D"/>
    <SolidColorBrush x:Key="SignalRelayBrush" Color="#5AB8F0"/>
    <SolidColorBrush x:Key="SignalWarningBrush" Color="#E9B054"/>
    <SolidColorBrush x:Key="SignalAlertBrush" Color="#F45D6B"/>
    <SolidColorBrush x:Key="SignalSyncBrush" Color="#A585F5"/>
    <SolidColorBrush x:Key="SignalIdleBrush" Color="#6B7385"/>

    <!-- ── Shell backgrounds ─────────────────────────────────────────────── -->
    <LinearGradientBrush x:Key="WarmShellBackgroundBrush" StartPoint="0.16,0" EndPoint="0.6,1">
        <GradientStop Color="#F3F2EF" Offset="0"/>
        <GradientStop Color="#EDECE8" Offset="0.5"/>
        <GradientStop Color="#E4E2DD" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ConsoleShellBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#131722" Offset="0"/>
        <GradientStop Color="#11141B" Offset="0.55"/>
        <GradientStop Color="#0A0C11" Offset="1"/>
    </LinearGradientBrush>

    <!-- ── Geometry: square-leaning, hence the name ──────────────────────── -->
    <CornerRadius x:Key="CardCornerRadius">28</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">20</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">16</CornerRadius>

    <!-- ── Typography ────────────────────────────────────────────────────── -->
    <!--
        Bundled from Google Fonts so the look does not depend on a machine-local
        install. The '#Family Name' suffix must match the name inside the file.
    -->
    <FontFamily x:Key="VaultFontFamily">ms-appx:///Assets/Fonts/SpaceGrotesk.ttf#Space Grotesk</FontFamily>
    <FontFamily x:Key="VaultMonoFontFamily">ms-appx:///Assets/Fonts/AzeretMono.ttf#Azeret Mono</FontFamily>

    <!-- ── WinUI default-brush overrides ─────────────────────────────────── -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#0A0C11"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#191D27"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#242935"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#11141B"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#BAC2D2"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#B8BAC2D2"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#75BAC2D2"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#6E7BF2"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#5866DC"/>

    <!-- Focus ring is coral, so it stays legible on iris-filled primary buttons. -->
    <SolidColorBrush x:Key="FocusStrokeColorOuter" Color="#FF8A6B"/>
    <SolidColorBrush x:Key="FocusStrokeColorInner" Color="#0A0C11"/>

    <!-- ── Scrollbars: sunken track, iris on hover ───────────────────────── -->
    <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="#070810"/>
    <SolidColorBrush x:Key="ScrollBarForeground" Color="#323847"/>
    <SolidColorBrush x:Key="ScrollBarBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#070810"/>
    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#070810"/>
    <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="Transparent"/>
    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#323847"/>
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#6E7BF2"/>
    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#5866DC"/>
    <SolidColorBrush x:Key="ScrollBarButtonBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="ScrollBarButtonArrowForeground" Color="#75BAC2D2"/>
    <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPointerOver" Color="#BAC2D2"/>

    <!-- ── ProgressBar ───────────────────────────────────────────────────── -->
    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="#14FFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource IrisBrush}"/>
        <Setter Property="MinHeight" Value="4"/>
        <Setter Property="CornerRadius" Value="2"/>
    </Style>

    <!--
        Shared button look for the console region. Controls use the 4px radius so
        the family reads square, per the vaultsqware geometry scale.
    -->
    <Style x:Key="ConsoleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource ConsoleBorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="FontFamily" Value="{StaticResource VaultFontFamily}"/>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource IrisBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
        <Setter Property="Foreground" Value="#0A0C11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="FontFamily" Value="{StaticResource VaultFontFamily}"/>
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource SignalAlertBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
        <Setter Property="Foreground" Value="{StaticResource SignalAlertBrush}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontFamily" Value="{StaticResource VaultFontFamily}"/>
    </Style>
</ResourceDictionary>
