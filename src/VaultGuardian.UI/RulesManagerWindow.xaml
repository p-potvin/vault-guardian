<Window x:Class="VaultGuardian.UI.RulesManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VaultGuardian.UI"
        Title="Rule Manager" Height="500" Width="700"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <local:BlockToTextConverter x:Key="BlockToTextConverter"/>
        <local:BlockToColorConverter x:Key="BlockToColorConverter"/>
        <local:PersistentToTextConverter x:Key="PersistentToTextConverter"/>
        <local:PersistentToColorConverter x:Key="PersistentToColorConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Firewall Rules" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <ListView x:Name="RulesList" Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" Foreground="White"
                  MouseDoubleClick="OnRulesListDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="150"/>
                    <GridViewColumn Header="Address/CIDR" DisplayMemberBinding="{Binding RemoteAddress}" Width="150"/>
                    <GridViewColumn Header="Port" DisplayMemberBinding="{Binding RemotePort}" Width="60"/>
                    <GridViewColumn Header="Protocol" DisplayMemberBinding="{Binding Protocol}" Width="80"/>
                    <GridViewColumn Header="Action" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Block, Converter={StaticResource BlockToTextConverter}}"
                                           Foreground="{Binding Block, Converter={StaticResource BlockToColorConverter}}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Lifetime" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IsPersistent, Converter={StaticResource PersistentToTextConverter}}"
                                           Foreground="{Binding IsPersistent, Converter={StaticResource PersistentToColorConverter}}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Add Rule" Click="OnAddRuleClick" Padding="15,8" Margin="0,0,10,0" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"/>
            <Button Content="Edit Selected" Click="OnEditRuleClick" Padding="15,8" Margin="0,0,10,0" Background="{StaticResource CardHoverBrush}" Foreground="White" BorderThickness="0"/>
            <Button Content="Remove Selected" Click="OnRemoveRuleClick" Padding="15,8" Background="{StaticResource ErrorBrush}" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
