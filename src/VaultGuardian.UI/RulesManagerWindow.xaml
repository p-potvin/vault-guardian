<Window
    x:Class="VaultGuardian.UI.RulesManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VaultGuardian.UI"
    Title="Rule Manager">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A0C11" Offset="0"/>
                <GradientStop Color="#0b0813" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Firewall Rules" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,16"/>

            <Border Grid.Row="1"
                    Background="{StaticResource ConsoleRaisedBrush}"
                    BorderBrush="{StaticResource ConsoleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="12,8" Background="#1AFFFFFF">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Name"       Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="Address"    Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Grid.Column="2" Text="Port"       Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Grid.Column="3" Text="Protocol"   Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Grid.Column="4" Text="Lifetime"   Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Grid.Column="5" Text="Action"     Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" FontSize="11"/>
                    </Grid>

                    <ListView x:Name="RulesList" Grid.Row="1"
                              SelectionMode="Single"
                              Background="Transparent"
                              DoubleTapped="OnRowDoubleTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:RuleRowVM">
                                <Grid Padding="6,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Name, Mode=OneTime}"
                                               Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind RemoteAddress, Mode=OneTime}"
                                               Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"
                                               FontFamily="{StaticResource VaultMonoFontFamily}"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind RemotePort, Mode=OneTime}"
                                               Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"
                                               FontFamily="{StaticResource VaultMonoFontFamily}"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind Protocol, Mode=OneTime}"
                                               Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4"
                                               Text="{x:Bind local:RulesManagerWindow.FormatLifetime(IsPersistent), Mode=OneTime}"
                                               Foreground="{x:Bind local:RulesManagerWindow.LifetimeBrush(IsPersistent), Mode=OneTime}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5"
                                               Text="{x:Bind local:RulesManagerWindow.FormatAction(Block), Mode=OneTime}"
                                               Foreground="{x:Bind local:RulesManagerWindow.ActionBrush(Block), Mode=OneTime}"
                                               VerticalAlignment="Center" FontWeight="Bold"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0" Spacing="10">
                <Button Content="Add Rule" Click="OnAddRuleClick"
                        Padding="18,10"
                        Background="{StaticResource IrisBrush}"
                        Foreground="#0A0C11" FontWeight="SemiBold"
                        BorderThickness="0" CornerRadius="12"/>
                <Button Content="Edit Selected" Click="OnEditRuleClick"
                        Padding="18,10"
                        Background="{StaticResource CoralBrush}"
                        Foreground="#0A0C11" FontWeight="SemiBold"
                        BorderThickness="0" CornerRadius="12"/>
                <Button Content="Remove Selected" Click="OnRemoveRuleClick"
                        Padding="18,10"
                        Background="{StaticResource SignalAlertBrush}"
                        Foreground="#0A0C11" FontWeight="SemiBold"
                        BorderThickness="0" CornerRadius="12"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
