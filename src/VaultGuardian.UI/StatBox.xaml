<UserControl
    x:Class="VaultGuardian.UI.StatBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource ConsoleSurfaceBrush}"
            CornerRadius="{StaticResource PanelCornerRadius}"
            Padding="20,16"
            BorderThickness="1"
            BorderBrush="{StaticResource ConsoleBorderBrush}">
        <Grid>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="LabelText" Text="LABEL" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource TertiaryTextBrush}" Margin="0,0,0,4"/>
                <TextBlock x:Name="NumText" Text="0" FontSize="28" FontWeight="Bold"
                           FontFamily="{StaticResource VaultMonoFontFamily}"
                           Foreground="{StaticResource PrimaryTextBrush}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
