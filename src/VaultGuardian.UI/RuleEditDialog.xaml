<ContentDialog
    x:Class="VaultGuardian.UI.RuleEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Egress Rule"
    PrimaryButtonText="Save"
    SecondaryButtonText="Cancel"
    DefaultButton="Primary"
    Background="{StaticResource ConsoleElevatedBrush}"
    Foreground="{StaticResource PrimaryTextBrush}"
    CornerRadius="{StaticResource OverlayCornerRadius}">
    <StackPanel MinWidth="420" Spacing="10">
        <TextBlock Text="Name" Foreground="{StaticResource SecondaryTextBrush}"/>
        <TextBox x:Name="NameBox" PlaceholderText="e.g. Block telemetry"/>

        <TextBlock Text="Process Path (optional)" Foreground="{StaticResource SecondaryTextBrush}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ProcessBox" Grid.Column="0" PlaceholderText="C:\Path\To\app.exe"/>
            <Button x:Name="BrowseButton" Grid.Column="1" Margin="8,0,0,0" Content="Browse..."
                    Click="OnBrowseClick"
                    Background="{StaticResource ConsoleRaisedBrush}"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    BorderBrush="{StaticResource ConsoleBorderBrush}"
                    CornerRadius="8"/>
        </Grid>

        <TextBlock Text="Remote Address / CIDR (optional)" Foreground="{StaticResource SecondaryTextBrush}"/>
        <TextBox x:Name="AddressBox" PlaceholderText="e.g. 10.0.0.0/8 or 1.2.3.4"/>

        <TextBlock Text="Remote Host (optional)" Foreground="{StaticResource SecondaryTextBrush}"/>
        <TextBox x:Name="HostBox" PlaceholderText="e.g. telemetry.example.com"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Port (optional)" Foreground="{StaticResource SecondaryTextBrush}"/>
                <TextBox x:Name="PortBox" PlaceholderText="0-65535"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Protocol" Foreground="{StaticResource SecondaryTextBrush}"/>
                <ComboBox x:Name="ProtocolBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Any"/>
                    <ComboBoxItem Content="Tcp"/>
                    <ComboBoxItem Content="Udp"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <ToggleSwitch x:Name="BlockSwitch" Header="Action" OffContent="Allow" OnContent="Block" IsOn="True"/>

        <ToggleSwitch x:Name="PersistSwitch" Header="Lifetime" OffContent="Session only" OnContent="Persistent across restarts" IsOn="True"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource SignalAlertBrush}" Visibility="Collapsed"
                   TextWrapping="Wrap"/>
    </StackPanel>
</ContentDialog>
