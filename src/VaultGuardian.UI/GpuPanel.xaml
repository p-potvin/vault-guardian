<UserControl
    x:Class="VaultGuardian.UI.GpuPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VaultGuardian.UI">
    <Border Background="{StaticResource ConsoleRaisedBrush}"
            BorderBrush="{StaticResource ConsoleBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource CardCornerRadius}"
            Padding="24" Margin="0,0,0,15">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="GPU"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontFamily="{StaticResource VaultMonoFontFamily}"
                       FontSize="12" FontWeight="Bold"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,15"/>

            <local:MetricControl x:Name="LoadMetric" Label="GPU Load" Margin="0,0,0,15"/>
            <local:MetricControl x:Name="VramMetric" Label="VRAM Utilization" Margin="0,0,0,15"/>

            <TextBlock x:Name="VramDetailText" Text="0.0 / 0.0 GB"
                       FontFamily="{StaticResource VaultMonoFontFamily}"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="11" Margin="0,0,0,10"/>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="TEMP" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/>
                    <TextBlock x:Name="TempText" Text="0°C"
                               FontFamily="{StaticResource VaultMonoFontFamily}"
                               Foreground="{StaticResource PrimaryTextBrush}" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="FAN" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/>
                    <TextBlock x:Name="FanText" Text="0%"
                               FontFamily="{StaticResource VaultMonoFontFamily}"
                               Foreground="{StaticResource PrimaryTextBrush}" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="POWER" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"/>
                    <TextBlock x:Name="PowerText" Text="0.0 W"
                               FontFamily="{StaticResource VaultMonoFontFamily}"
                               Foreground="{StaticResource PrimaryTextBrush}" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
