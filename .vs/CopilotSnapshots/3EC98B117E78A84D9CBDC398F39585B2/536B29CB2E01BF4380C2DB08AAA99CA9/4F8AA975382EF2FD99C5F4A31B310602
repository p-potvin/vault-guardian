<UserControl x:Class="VaultGuardian.UI.MetricControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,5">
    <StackPanel>
        <DockPanel LastChildFill="False">
            <TextBlock x:Name="LabelText" Text="Usage" FontWeight="SemiBold"/>
            <TextBlock x:Name="ValueText" Text="0.0%" DockPanel.TargetProperty="Right" FontWeight="Bold"/>
        </DockPanel>
        <ProgressBar x:Name="Bar" Height="10" Background="#DDD"/>
    </StackPanel>
</UserControl>
