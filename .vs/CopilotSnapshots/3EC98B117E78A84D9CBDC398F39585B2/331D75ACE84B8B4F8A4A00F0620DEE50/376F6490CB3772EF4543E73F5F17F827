using System.Diagnostics;
using System.Net;
using Microsoft.Extensions.Logging;
using WindivertDotnet;

namespace VaultGuardian.Core.Interception;

public sealed class WinDivertInterceptor : IInterceptor
{
    private readonly RuleDecisionEngine _engine;
    private readonly ILogger<WinDivertInterceptor> _logger;
    private readonly WinDivert _divert;
    private Task? _runTask;
    private CancellationTokenSource? _cts;

    public WinDivertInterceptor(RuleDecisionEngine engine, ILogger<WinDivertInterceptor> logger)
    {
        _engine = engine;
        _logger = logger;
        // outbound traffic only, process-aware
        _divert = new WinDivert("outbound", WinDivertLayer.Network);
    }

    public Task StartAsync(CancellationToken cancellationToken)
    {
        _cts = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
        _runTask = Task.Run(() => RunInterceptionLoopAsync(_cts.Token), _cts.Token);
        return Task.CompletedTask;
    }

    private async Task RunInterceptionLoopAsync(CancellationToken ct)
    {
        using var buffer = new WinDivertBuffer(65535);

        while (!ct.IsCancellationRequested)
        {
            try
            {
                var recvResult = _divert.Recv(buffer);
                if (!recvResult.Success) continue;

                var packet = recvResult.Packet;
                var address = recvResult.Address;

                if (packet.IPv4Header != null && (packet.TcpHeader != null || packet.UdpHeader != null))
                {
                    var observation = CreateObservation(packet, address);
                    var decision = _engine.Evaluate(observation);

                    if (decision.Action == DecisionAction.Block)
                    {
                        _logger.LogWarning("Blocking traffic: {Process} -> {Dest} ({Rule})", 
                            observation.ProcessName, observation.RemoteAddress, decision.MatchedRuleName);
                        // Drop the packet by not calling Send
                        continue;
                    }
                }

                _divert.Send(packet, address);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error in WinDivert loop");
            }
        }
    }

    private TrafficObservation CreateObservation(WinDivertPacket packet, WinDivertAddress address)
    {
        var remoteAddr = packet.IPv4Header!.DstAddr.ToString();
        var remotePort = packet.TcpHeader?.DstPort ?? packet.UdpHeader?.DstPort ?? 0;
        var protocol = packet.TcpHeader != null ? TrafficProtocol.Tcp : TrafficProtocol.Udp;

        // Resolve process from PID (WinDivertAddress.ProcessId)
        var pid = (int)address.ProcessId;
        var processName = "Unknown";
        var processPath = "Unknown";

        try
        {
            using var proc = Process.GetProcessById(pid);
            processName = proc.ProcessName;
            processPath = proc.MainModule?.FileName ?? "Unknown";
        }
        catch { /* Process exited or access denied */ }

        return new TrafficObservation(
            processName,
            processPath,
            null, // DNS resolution would happen here if phased in
            remoteAddr,
            remotePort,
            protocol);
    }

    public async Task StopAsync()
    {
        if (_cts != null) await _cts.CancelAsync();
        if (_runTask != null) await _runTask;
        _divert.Dispose();
    }

    public async ValueTask DisposeAsync()
    {
        await StopAsync();
    }
}
