<UserControl x:Class="VaultGuardian.UI.MetricControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,0,0,0">
        <Grid Margin="0,0,0,8">
            <TextBlock x:Name="LabelText" Text="Usage" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}"/>
            <TextBlock x:Name="ValueText" Text="0.0%" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryTextBrush}"/>
        </Grid>
        <ProgressBar x:Name="Bar" Height="4" Minimum="0" Maximum="100"/>
    </StackPanel>
</UserControl>
