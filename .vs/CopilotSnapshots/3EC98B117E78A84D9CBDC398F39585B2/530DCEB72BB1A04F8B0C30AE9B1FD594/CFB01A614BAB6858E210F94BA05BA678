<Application x:Class="VaultGuardian.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VaultGuardian.UI"
             xmlns:h="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf">
    <Application.Resources>
        <ResourceDictionary>
            <h:TaskbarIcon x:Key="NotifyIcon"
                           IconSource="pack://application:,,,/Assets/Icon.ico"
                           ToolTipText="VaultGuardian Passive Monitor">
                <h:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Show Dashboard" Click="ShowMainWindow_Click"/>
                        <Separator/>
                        <MenuItem Header="Exit" Click="ExitApp_Click"/>
                    </ContextMenu>
                </h:TaskbarIcon.ContextMenu>
            </h:TaskbarIcon>

            <!-- Modern Fluent-like Colors -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="#1C1C1C"/>
            <SolidColorBrush x:Key="CardBrush" Color="#2B2B2B"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#3D3D3D"/>
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="White"/>
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#AAAAAA"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
