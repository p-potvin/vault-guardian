<Window x:Class="VaultGuardian.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VaultGuardian Metrics Overlay" Height="130" Width="180" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False">
    <Border Background="#D01C1C1C" CornerRadius="12" Padding="12" BorderThickness="1" BorderBrush="#30FFFFFF">
        <StackPanel>
            <Grid Margin="0,0,0,8">
                <TextBlock Text="MONITOR" Foreground="{StaticResource TertiaryTextBrush}" FontSize="9" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="BlockedText" Text="0" Foreground="{StaticResource ErrorBrush}" FontSize="10" FontWeight="Bold"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,4">
                <TextBlock Text="CPU" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                <TextBlock x:Name="CpuText" Text="0%" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" HorizontalAlignment="Right" FontWeight="SemiBold"/>
            </Grid>
            <ProgressBar x:Name="CpuBar" Height="2" Margin="0,0,0,8" Foreground="{StaticResource AccentBrush}"/>

            <Grid Margin="0,0,0,4">
                <TextBlock Text="RAM" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                <TextBlock x:Name="RamText" Text="0.0 GB" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" HorizontalAlignment="Right" FontWeight="SemiBold"/>
            </Grid>
            <ProgressBar x:Name="RamBar" Height="2" Margin="0,0,0,8" Foreground="{StaticResource SuccessBrush}"/>

            <Grid Margin="0,0,0,4">
                <TextBlock Text="GPU" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                <TextBlock x:Name="GpuText" Text="0%" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" HorizontalAlignment="Right" FontWeight="SemiBold"/>
            </Grid>
            <ProgressBar x:Name="GpuBar" Height="2" Foreground="#76B900"/>
        </StackPanel>
    </Border>
</Window>
