<UserControl x:Class="VaultGuardian.UI.MetricControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,8">
    <StackPanel>
        <Grid Margin="0,0,0,6">
            <TextBlock x:Name="LabelText" Text="Usage" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
            <TextBlock x:Name="ValueText" Text="0.0%" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}"/>
        </Grid>
        <ProgressBar x:Name="Bar" Height="4" Minimum="0" Maximum="100"/>
    </StackPanel>
</UserControl>
