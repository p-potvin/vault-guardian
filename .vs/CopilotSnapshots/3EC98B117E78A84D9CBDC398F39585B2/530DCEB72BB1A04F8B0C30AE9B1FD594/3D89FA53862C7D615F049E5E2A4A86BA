<Window x:Class="VaultGuardian.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VaultGuardian.UI"
        mc:Ignorable="d"
        Title="VaultGuardian" Height="650" Width="1000" 
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Performance &amp; Security Dashboard" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Real-time system health and egress traffic monitoring" Foreground="{StaticResource SecondaryTextBrush}" FontSize="14"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Resources Column -->
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="System Resources" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <local:MetricControl x:Name="CpuMetric" Label="Processor Load" Color="#60CDFF"/>
                        <local:MetricControl x:Name="RamMetric" Label="Physical Memory" Color="#6CCB5F"/>
                        <local:MetricControl x:Name="GpuMetric" Label="NVIDIA GPU Core" Color="#76B900"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <DockPanel>
                        <TextBlock Text="Live Actions" VerticalAlignment="Center" FontSize="16" FontWeight="Medium"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox x:Name="ShowOverlayCheckbox" Content="Desktop Overlay" IsChecked="True" Checked="OnOverlayToggled" Unchecked="OnOverlayToggled" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="White"/>
                            <Button Content="View Rules" Padding="12,6" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- Traffic Column -->
            <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="12,0,0,12" VerticalAlignment="Top">
               <StackPanel>
                    <TextBlock Text="Egress Traffic Stats" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <local:StatBox x:Name="TotalStats" Label="TOTAL FLOWS" Color="#999"/>
                    <local:StatBox x:Name="AllowedStats" Label="ALLOWED" Color="#28A745"/>
                    <local:StatBox x:Name="BlockedStats" Label="BLOCKED" Color="#E81123"/>
               </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#1A5FB4" CornerRadius="4" Padding="12" Margin="0,24,0,0">
            <TextBlock Text="System Protected: WinDivert active. Rules are being enforced across all processes." Foreground="White"/>
        </Border>
    </Grid>
</Window>
