<UserControl x:Class="VaultGuardian.UI.StatBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,8">
    <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="16" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
        <DockPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="NumText" Text="0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                <TextBlock x:Name="LabelText" Text="LABEL" FontSize="11" FontWeight="Medium" Foreground="{StaticResource SecondaryTextBrush}"/>
            </StackPanel>
            <TextBlock Text="⚡" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" Foreground="#555"/>
        </DockPanel>
    </Border>
</UserControl>